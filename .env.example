# AstroBot 电商智能客服环境变量配置示例
# 适配任意兼容 OpenAI 协议的上游（OpenAI、DeepSeek、SiliconFlow、Ollama、Claude 代理等）

# 模型访问密钥（必填）
OPENAI_API_KEY=sk-your-api-key-here

# 模型端点 Base URL（可选，默认使用 OpenAI 官方地址 https://api.openai.com/v1）
# DeepSeek 示例: https://api.deepseek.com/v1
# Ollama 示例: http://localhost:11434/v1
# SiliconFlow 示例: https://api.siliconflow.cn/v1
OPENAI_BASE_URL=

# 模型名称
# 可选: gpt-4o-mini, deepseek-chat, deepseek-ai/DeepSeek-V3, qwen-plus 等
OPENAI_MODEL_NAME=gpt-4o-mini

# 采样温度 (0.0 ~ 2.0，客服场景建议 0.5 ~ 0.7 保证回答稳定与适度亲和力)
OPENAI_TEMPERATURE=0.7

# 上下文历史最大保留 Token 预算
MAX_CONTEXT_TOKENS=2000
